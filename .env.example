# Nebius Token Factory (OpenAI-compatible). Check the console for exact model IDs.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
CHAT_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# Must match the embedding model's output size. Changing it later needs a fresh migration.
EMBED_DIM=4096

DATABASE_URL=postgresql+asyncpg://loops:loops@db:5432/loops

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/sources/gmail/callback

# From https://my.telegram.org
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=secrets/telegram.session
# Optional JSON lists of chat ids
TG_CHAT_ALLOWLIST=[]
TG_CHAT_DENYLIST=[]

BOT_TOKEN=
OWNER_TELEGRAM_ID=

# Generate with: loops gen-key
ENCRYPTION_KEY=
WEB_PASSWORD=
PUBLIC_BASE_URL=http://localhost:8000

BACKFILL_DAYS=90
TIMEZONE=Africa/Addis_Ababa
